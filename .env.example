# CCCN Hub (PRODUCTION) — variables de entorno. NUNCA se completan en este repo: van en
# Azure App Service → Configuration → Application settings, con los secretos referenciados
# desde Key Vault (Panorama Legal, Paso 1). Este archivo es solo la lista documentada.
# Ver docs/DEPLOY_AZURE.md.

# ---- Entorno ----
HUB_ENV=production
HUB_BASE_URL=https://community.centrocultural.cr

# ---- Base de datos ----
# Obligatorio. Postgres — Azure Flexible Server o Supabase (ver ARQUITECTURA.md §8,
# "por definir"). sslmode=require siempre.
HUB_DATABASE_URL=postgresql+psycopg://USUARIO:PASSWORD@SERVIDOR.postgres.database.azure.com:5432/hub?sslmode=require

# ---- Secretos ----
# Obligatorios. Generar una vez y cargar en Key Vault, no en App Settings en texto plano:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
HUB_JWT_SECRET=
HUB_SESSION_SECRET=
HUB_JWT_TTL_MINUTES=60

# ---- OAuth (vacío = proveedor deshabilitado) ----
# Google:    https://console.cloud.google.com/apis/credentials
#            redirect: HUB_BASE_URL/api/v1/auth/oauth/google/callback
HUB_GOOGLE_CLIENT_ID=
HUB_GOOGLE_CLIENT_SECRET=
# Microsoft Entra: App registration
#            redirect: HUB_BASE_URL/api/v1/auth/oauth/microsoft/callback
HUB_MS_CLIENT_ID=
HUB_MS_CLIENT_SECRET=
HUB_MS_TENANT=common

# ---- Servicios externos ----
HUB_OVERDRIVE_URL=https://centrocultural.overdrive.com/

# ---- Contacto ----
HUB_MAIL_FROM=hub@centrocultural.cr
HUB_CONTACTO_DATOS=datos@centrocultural.cr   # canal ARCO publicado en las páginas legales

# ---- Límites de tasa (por IP, ventana de 60 s) ----
HUB_RATE_LIMIT_PUBLIC=60
HUB_RATE_LIMIT_AUTH=10

# ---- Reglas de circulación de biblioteca ----
HUB_PRESTAMO_DIAS=14
HUB_PRESTAMO_MAX_ACTIVOS=3
HUB_MULTA_DIARIA_CRC=200

# ---- Retención ----
HUB_AUDIT_RETENTION_DAYS=1095                # 3 años
